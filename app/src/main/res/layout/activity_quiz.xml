<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/lavender_dark"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quiz_progress"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="5"
            android:progress="1"
            android:progressTint="@color/lavender"
            android:progressBackgroundTint="@color/lavender_light"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_title"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/lavender_dark"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnAnswer1"
            style="@style/QuizlyAnswerButton"
            android:text="@string/answer_placeholder"/>

        <Button
            android:id="@+id/btnAnswer2"
            style="@style/QuizlyAnswerButton"
            android:text="@string/answer_placeholder"/>

        <Button
            android:id="@+id/btnAnswer3"
            style="@style/QuizlyAnswerButton"
            android:text="@string/answer_placeholder"/>

        <Button
            android:id="@+id/btnAnswer4"
            style="@style/QuizlyAnswerButton"
            android:text="@string/answer_placeholder"/>

        <Button
            android:id="@+id/btnNext"
            style="@style/QuizlyPrimaryButton"
            android:text="@string/next_question"
            android:layout_marginTop="24dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>