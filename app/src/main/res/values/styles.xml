<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="QuizlyPrimaryButton"
        parent="Widget.AppCompat.Button">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>

    </style>

    <style name="QuizlyAnswerButton"
        parent="Widget.AppCompat.Button">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/answer_default</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:stateListAnimator">@null</item>

    </style>

    <style name="QuizlySecondaryButton"
        parent="Widget.AppCompat.Button">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/lavender_dark</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>

    </style>

</resources>